{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nomad",
  "version": "0.1.0",
  "identifier": "in.ascentads.nomad",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nomad",
        "width": 800,
        "height": 600,
        "minWidth": 640,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Work in focused stretches. Rest on time.",
    "longDescription": "Nomad is a simple work-and-break timer. Set how long you want to work and how long to rest, press Start, and it reminds you when to step away and when to come back."
  }
}
